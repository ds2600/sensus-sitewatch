# Copy to /etc/nginx/sites-available/sitewatch, symlink into sites-enabled,
# then edit server_name and the ssl_certificate paths. See README section 15.
#
# TLS matters here even for a LAN-only internal tool: login posts the
# admin password in plaintext over HTTP otherwise. A self-signed cert is
# fine for internal-only access (README section 15 has the openssl command);
# use a real CA-issued cert if one is available.

server {
    listen 80;
    server_name sitewatch.internal;  # LAN hostname or IP of this host
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name sitewatch.internal;

    ssl_certificate     /etc/ssl/sitewatch/fullchain.pem;
    ssl_certificate_key /etc/ssl/sitewatch/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
